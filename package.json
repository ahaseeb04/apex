        "@types/bun": "latest",
        "concurrently": "^9"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "patchedDependencies": {
        "react-native-css-interop@0.2.4": "patches/react-native-css-interop@0.2.4.patch"
    }
}
