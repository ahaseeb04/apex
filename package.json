{
    "name": "powerlifting-tracker",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n api,coach -c blue,green \"bun run --filter api dev\" \"bun run --filter coach dev\""
    },
